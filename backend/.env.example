# Copy to .env and fill in real values. Never commit .env itself.

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Origin allowed by CORS — the Vite dev server by default.
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# MongoDB Atlas SRV string or a local mongodb:// URI.
MONGODB_URI=

# Local-only workaround: set to true if your network cannot resolve the Atlas
# SRV record. Leave unset in any hosted environment — it overrides DNS for the
# whole process and will break internal/VPC name resolution.
# FORCE_PUBLIC_DNS=false

# ---------- Auth ----------
# Use a long random string, e.g. `openssl rand -base64 48`.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- AI content generation ----------
# Google AI Studio key. Without it the app falls back to template captions.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash-lite

# ---------- Social platform OAuth ----------
# Not read by the code yet: account connections are simulated. These are
# placeholders for when real OAuth flows are implemented.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
